# B3 kernel for nash: DT platform expert, ArmCpu, architectural timer and the
# block fixtures. corecrypto is required by ArmCpu. mockfs needs pthread.
#
# Delivery: the prelinked kernel is about 51 MiB, which exceeds the ~32 MiB
# ramdisk limit of the nash ABL, so the payload FAT volume lives on the
# unused oem_a partition (1.3 GiB) and the boot image ships without a ramdisk.
# UniXNU scans every SimpleFileSystem volume for \EFI\UniXNU\unixnu.toml.

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
# Read the panic log region from the device tree (pram + /chosen) instead of
# the Apple iBoot physical address, which does not exist on nash.
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_SOURCE_MOCKFS=y

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"

# Later milestones:
# CONFIG_XNU_NATIVE_LEGACY_DISPLAY is not set
# CONFIG_XNU_BOOT_PROGRESS is not set
CONFIG_XNU_NATIVE_UFS=y
