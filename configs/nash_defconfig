# First nash kernel: DT platform expert only.
# The nash ABL limits the ramdisk to about 32 MiB. ArmCpu needs corecrypto, and the
# architectural timer and mockfs need ArmCpu, so the prelinked kernel never fits.
# This build exists to prove the boot chain: DarwinBoot loads XNU, XNU runs on nash
# and reaches its console/panic path.

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y

# CONFIG_XNU_ARMCPU is not set
# CONFIG_XNU_NATIVE_ARCH_TIMER is not set
# CONFIG_XNU_SOURCE_CORECRYPTO14 is not set
# CONFIG_XNU_SOURCE_PTHREAD is not set
# CONFIG_XNU_SOURCE_MOCKFS is not set
# CONFIG_XNU_NATIVE_RAM_BLOCK is not set
# CONFIG_XNU_NATIVE_CS_HASH_CACHE is not set
# CONFIG_XNU_NATIVE_LEGACY_DISPLAY is not set
# CONFIG_XNU_NATIVE_UFS is not set
